# Copy to .env.local and fill in. Without the two Supabase values the app
# still runs, but shows a "Supabase is not configured" notice and no data.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" key (sb_publishable_…). The legacy anon key also works:
# set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public URL of the deployed site, used for auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" only after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Which university the site is scoped to (matches universities.slug).
NEXT_PUBLIC_DEFAULT_UNIVERSITY_SLUG=tec
